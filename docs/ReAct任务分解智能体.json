      },
      "position": {
        "x": 100,
        "y": 350
      }
    },
    {
      "id": "extract-1",
      "type": "json_extractor",
      "data": {
        "label": "提取分析结果",
        "input_variable": "analysis",
        "output_variable": "analysis_result"
      },
      "position": {
        "x": 100,
        "y": 500
      }
    },
    {
      "id": "act-1",
      "type": "llm",
      "data": {
        "label": "Acting - 任务分解",
        "system_prompt": "你是一个专业的任务拆解专家。",
        "prompt": "基于以下分析进行任务分解：\n\n分析结果：{{analysis_result}}\n\n请用JSON格式输出完整的任务分解：\n{\n  \"project_type\": \"{{analysis_result.project_type}}\",\n  \"subtasks\": [\n    {\n      \"id\": \"1\",\n      \"name\": \"任务名称\",\n      \"description\": \"详细描述\",\n      \"priority\": \"high/medium/low\",\n      \"estimated_hours\": 8,\n      \"dependencies\": []\n    }\n  ],\n  \"total_estimated_hours\": 0,\n  \"critical_path\": []\n}",
        "output_variable": "task_decomposition"
      },
      "position": {
        "x": 100,
        "y": 650
      }
    },
    {
      "id": "extract-2",
      "type": "json_extractor",
      "data": {
        "label": "提取任务分解",
        "input_variable": "task_decomposition",
        "output_variable": "task_plan"
      },
      "position": {
        "x": 100,
        "y": 800
      }
    },
    {
      "id": "observe-1",
      "type": "llm",
      "data": {
        "label": "Observation - 评估结果",
        "system_prompt": "你是一个质量检查专家。",
        "prompt": "请评估以下任务分解结果：\n\n任务分解：{{task_plan}}\n\n请评估：\n1. 是否遗漏了重要任务？\n2. 任务粒度是否合适？\n3. 优先级是否合理？\n\n请用JSON格式输出：\n{\n  \"is_complete\": true/false,\n  \"needs_revision\": true/false,\n  \"feedback\": \"反馈意见\"\n}",
        "output_variable": "observation"
      },
      "position": {
        "x": 100,
        "y": 950
      }
    },
    {
      "id": "extract-3",
      "type": "json_extractor",
      "data": {
        "label": "提取评估结果",
        "input_variable": "observation",
        "output_variable": "observation_result"
      },
      "position": {
        "x": 100,
        "y": 1100
      }
    },
    {
      "id": "condition-1",
      "type": "condition",
      "data": {
        "label": "判断 - 是否继续优化",
        "condition": "i < 2"
      },
      "position": {
        "x": 100,
        "y": 1250
      }
    },
    {
      "id": "loop-1",
      "type": "loop",
      "data": {
        "label": "循环计数+1",
        "loop_variable": "i",
        "loop_max": 2
      },
      "position": {
        "x": 100,
        "y": 1400
      }
    },
    {
      "id": "revise-1",
      "type": "llm",
      "data": {
        "label": "Revise - 优化任务分解",
        "system_prompt": "你是一个任务优化专家。",
        "prompt": "请根据以下反馈优化任务分解：\n\n当前任务分解：{{task_plan}}\n\n反馈意见：{{observation_result.feedback}}\n\n请输出优化后的完整JSON格式。",
        "output_variable": "revised_plan"
      },
      "position": {
        "x": 100,
        "y": 1550
      }
    },
    {
      "id": "update-1",
      "type": "json_extractor",
      "data": {
        "label": "更新任务计划",
        "input_variable": "revised_plan",
        "output_variable": "task_plan"
      },
      "position": {
        "x": 100,
        "y": 1700
      }
    },
    {
      "id": "final-1",
      "type": "llm",
      "data": {
        "label": "生成最终报告",
        "system_prompt": "你是一个报告生成专家。",
        "prompt": "请基于最终任务分解生成一份完整的WBS报告：\n\n最终任务分解：{{task_plan}}\n\n请生成Markdown格式的报告，包含项目概述、任务列表、时间估算汇总等。",
        "output_variable": "final_report"
      },
      "position": {
        "x": 400,
        "y": 1250
      }
    },
    {
      "id": "output-1",
      "type": "output",
      "data": {
        "label": "输出结果",
        "output_variable": "result",
        "output_content": "{{final_report.response}}"
      },
      "position": {
        "x": 400,
        "y": 1400
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "data": {
        "label": "结束"
      },
      "position": {
        "x": 400,
        "y": 1550
      }
    }
