        "prompt": "请分析以下软件开发需求：\n\n用户需求：{{input.text}}\n\n请用JSON格式输出：\n{\n  \"project_type\": \"项目类型\",\n  \"core_features\": [\"核心功能列表\"],\n  \"constraints\": [\"约束条件\"],\n  \"initial_thoughts\": \"初步思考\"\n}",
