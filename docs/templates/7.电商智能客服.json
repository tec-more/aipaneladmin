          "reason": {"type": "string", "description": "退款原因"}
        },
        "required": ["order_id", "reason"]
      },
      "enabled": true
    }
  ],
  "skills": [
    {
      "name": "情绪安抚",
      "description": "安抚情绪激动或不满的用户",
      "implementation": "## 情绪安抚技能\n\n### 目标\n平复用户情绪，建立良好沟通氛围。\n\n### 步骤\n1. 表达理解和共情\n2. 真诚道歉（如适用）\n3. 承诺解决问题\n4. 给出处理方案\n5. 保持耐心",
      "status": "active",
      "category_id": 2
    },
    {
      "name": "问题升级",
      "description": "处理需要升级的复杂问题",
      "implementation": "## 问题升级技能\n\n### 目标\n确保复杂问题得到妥善处理。\n\n### 步骤\n1. 记录问题详情\n2. 评估是否需要升级\n3. 告知用户处理流程\n4. 转接相关负责人\n5. 跟进处理进度",
      "status": "active",
      "category_id": 2
    }
  ],
  "rag": {
    "name": "电商知识库",
    "description": "包含商品知识、售后政策、常见问题等",
    "documents": [
      "常见问题FAQ",
      "退换货政策",
