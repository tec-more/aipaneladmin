"""
真正的实时语音翻译 - WebSocket双向通信

客户端边录音边发送音频数据，服务器实时转发到豆包AST并返回翻译结果
不需要等待录音完成，边录音边翻译！
"""
from fastapi import APIRouter, WebSocket, WebSocketDisconnect, Query
from typing import Optional
import logging
import json
import uuid
import io
import wave
import asyncio
from pathlib import Path

from base.common.security import get_current_user_id_ws
from base.plugins.llm.models.voice import LLMVoiceRecord
from base.plugins.llm.services.voice_helper import VoiceServiceHelper

logger = logging.getLogger(__name__)

voice_websocket_streaming_router = APIRouter(
    prefix="/voice",
    tags=["语音服务-实时流式翻译"],
)


@voice_websocket_streaming_router.websocket("/translation/streaming/deprecated")
async def realtime_streaming_translation(
    websocket: WebSocket,
    provider_id: int = Query(..., description="厂商ID"),
    token: Optional[str] = Query(None, description="认证token")
):
    """
    真正的实时语音翻译 - WebSocket接口

    工作流程：
    1. 客户端连接后发送start消息
    2. 服务器立即连接豆包AST并建立会话
    3. 客户端每发送一个音频块，服务器立即转发给豆包
    4. 服务器同时监听豆包的响应，实时转发给客户端
    5. 客户端可以一边录音一边看到翻译结果！

    实时翻译，无需等待录音完成！
    """
    logger.info(f"[实时流式翻译] 收到连接请求")
    logger.info(f"[实时流式翻译] provider_id={provider_id}")

    await websocket.accept()
    logger.info(f"[实时流式翻译] WebSocket连接已accept")

    session_id = None
    record = None
    doubao_ws = None  # 豆包WebSocket连接

    try:
        # 验证用户身份
        user_id = await get_current_user_id_ws(token)
        logger.info(f"[实时流式翻译] token验证结果: user_id={user_id}")

        if not user_id:
            logger.error(f"[实时流式翻译] token验证失败")
            await websocket.send_json({"type": "error", "message": "未授权"})
            await websocket.close(code=1008, reason="Unauthorized")
            return

        logger.info(f"[实时流式翻译] 翻译会话开始，用户ID: {user_id}")

        # 获取语音服务
        service = await VoiceServiceHelper.get_voice_service(provider_id)

        # 音频配置
        config = {
            "format": "wav",
            "sample_rate": 16000,
            "source_language": "zh",
            "target_language": "en",
        }

        # 收到的音频块队列（客户端 -> 豆包）
        audio_queue = asyncio.Queue()

        # 停止标志
        stop_flag = asyncio.Event()

        # 主消息循环
        async def handle_client_messages():
            """处理客户端消息"""
            nonlocal session_id, record

            while not stop_flag.is_set():
                try:
                    message = await websocket.receive()

                    # 处理文本消息（控制消息）
                    if "text" in message:
                        try:
                            data = json.loads(message["text"])

                            if data.get("type") == "start":
                                # 开始会话
                                session_id = f"ws_stream_{uuid.uuid4().hex[:16]}"
                                config.update({
                                    "format": data.get("format", "wav"),
                                    "sample_rate": data.get("sample_rate", 16000),
                                    "source_language": data.get("source_language", "zh"),
                                    "target_language": data.get("target_language", "en"),
                                })

                                logger.info(f"[实时流式翻译] ========== 创建新会话 ==========")
                                logger.info(f"[实时流式翻译] Session ID: {session_id}")
                                logger.info(f"[实时流式翻译] 配置: {config}")

                                # 创建记录
                                record = await LLMVoiceRecord.create(
                                    record_id=session_id,
                                    customer_id=user_id,
                                    model_id=provider_id,
                                    recognition_type="translation",
                                    audio_file="websocket_streaming",
                                    audio_format=config["format"],
                                    source_language=config["source_language"],
                                    target_language=config["target_language"],
                                    status="processing"
                                )

                                logger.info(f"[实时流式翻译] 数据库记录已创建, ID: {record.id}")

                                await websocket.send_json({
                                    "type": "started",
                                    "session_id": session_id
                                })

                                logger.info(f"[实时流式翻译] 会话已开始，连接豆包...")

                            elif data.get("type") == "end":
                                # 结束音频传输
                                logger.info(f"[实时流式翻译] ========== 收到end消息 ==========")
                                # 发送结束信号到队列
                                await audio_queue.put(None)
                                break

                        except json.JSONDecodeError as e:
                            await websocket.send_json({
                                "type": "error",
                                "message": f"JSON解析错误: {str(e)}"
                            })

                    # 处理二进制消息（音频数据）- 实时转发！
                    elif "bytes" in message:
                        audio_chunk = message["bytes"]

                        logger.debug(f"[实时流式翻译] 收到音频块: {len(audio_chunk)} bytes")

                        # 提取PCM数据（如果是WAV）
                        try:
                            if len(audio_chunk) >= 4 and audio_chunk[:4] == b'RIFF':
                                # WAV格式，提取PCM
                                audio_file_obj = io.BytesIO(audio_chunk)
                                with wave.open(audio_file_obj, 'rb') as wf:
                                    pcm_data = wf.readframes(wf.getnframes())
                                logger.debug(f"[实时流式翻译] 提取PCM: {len(audio_chunk)} -> {len(pcm_data)} bytes")
                            else:
                                # 纯PCM
                                pcm_data = audio_chunk
                                logger.debug(f"[实时流式翻译] 纯PCM数据: {len(pcm_data)} bytes")

                            # 放入队列，等待转发给豆包
                            await audio_queue.put(pcm_data)

                        except Exception as e:
                            logger.error(f"[实时流式翻译] 音频处理失败: {e}")
                            await websocket.send_json({
                                "type": "error",
                                "message": f"音频处理失败: {str(e)}"
                            })

                except WebSocketDisconnect:
                    logger.info(f"[实时流式翻译] 客户端断开连接")
                    stop_flag.set()
                    break
                except Exception as e:
                    logger.error(f"[实时流式翻译] 消息处理异常: {e}", exc_info=True)
                    stop_flag.set()
                    break

        # 转发音频到豆包的任务
        async def forward_to_doubao():
            """转发音频到豆包的异步任务"""
            nonlocal doubao_ws

            try:
                # 导入豆包AST服务
                from base.plugins.llm.services.doubao_ast_official import DoubaoASTOfficialService, Type, TranslateRequest, TranslateResponse
                import websockets
                from websockets import Headers

                if not isinstance(service, DoubaoASTOfficialService):
                    await websocket.send_json({
                        "type": "error",
                        "message": "此服务不支持实时流式翻译，请使用豆包AST官方服务"
                    })
                    return

                # 连接豆包AST
                ws_url = "wss://openspeech.bytedance.com/api/v4/ast/v2/translate"
                doubao_session_id = str(uuid.uuid4())
                conn_id = str(uuid.uuid4())

                headers = Headers({
                    "X-Api-App-Key": service.app_key,
                    "X-Api-Access-Key": service.access_key,
                    "X-Api-Resource-Id": service.resource_id,
                    "X-Api-Connect-Id": conn_id
                })

                logger.info(f"[豆包AST] 连接服务器...")

                async with websockets.connect(
                    ws_url,
                    additional_headers=headers,
                    max_size=1000000000,
                    ping_interval=None
                ) as ws:
                    doubao_ws = ws
                    logger.info(f"[豆包AST] WebSocket连接已建立")

                    # 发送StartSession
                    logger.info(f"[豆包AST] 发送StartSession")

                    start_request = TranslateRequest()
                    start_request.request_meta.SessionID = doubao_session_id
                    start_request.event = Type.StartSession

                    # 用户信息
                    start_request.user.uid = "ast_stream_client"
                    start_request.user.did = "ast_stream_client"

                    # 音频配置
                    start_request.source_audio.format = config["format"]
                    start_request.source_audio.rate = config["sample_rate"]
                    start_request.source_audio.bits = 16
                    start_request.source_audio.channel = 1

                    # 目标音频配置
                    start_request.target_audio.format = "ogg_opus"
                    start_request.target_audio.rate = 24000

                    # 请求配置
                    start_request.request.mode = "s2s"
                    start_request.request.source_language = config["source_language"]
                    start_request.request.target_language = config["target_language"]

                    # 序列化并发送
                    start_data = start_request.SerializeToString()
                    await ws.send(start_data)

                    logger.info(f"[豆包AST] 已发送StartSession ({len(start_data)} bytes)")

                    # 等待SessionStarted
                    response_data = await ws.recv()
                    logger.info(f"[豆包AST] 收到响应 ({len(response_data)} bytes)")

                    response = TranslateResponse()
                    response.ParseFromString(response_data)

                    if response.event != Type.SessionStarted:
                        error_msg = f"会话建立失败: {response.response_meta.Message}"
                        logger.error(f"[豆包AST] {error_msg}")
                        await websocket.send_json({
                            "type": "error",
                            "message": error_msg
                        })
                        return

                    logger.info(f"[豆包AST] 会话已建立 (session_id: {doubao_session_id})")

                    # 通知客户端豆包已准备好
                    await websocket.send_json({
                        "type": "doubao_ready",
                        "session_id": doubao_session_id
                    })

                    # 启动接收响应的任务
                    received_results = []

                    async def receive_responses():
                        """接收豆包的响应"""
                        try:
                            while not stop_flag.is_set():
                                response_data = await ws.recv()

                                response = TranslateResponse()
                                response.ParseFromString(response_data)

                                # 处理不同类型的事件
                                if response.event == Type.SessionFinished:
                                    logger.info(f"[豆包AST] 会话完成")
                                    result_dict = MessageToDict(response)
                                    await websocket.send_json({
                                        "type": "result",
                                        "event": "session_finished",
                                        "result": result_dict
                                    })
                                    received_results.append(result_dict)
                                    break

                                elif response.event == Type.SessionFailed:
                                    error_msg = response.response_meta.Message
                                    logger.error(f"[豆包AST] 会话失败: {error_msg}")
                                    await websocket.send_json({
                                        "type": "error",
                                        "message": error_msg,
                                        "event": "session_failed"
                                    })
                                    break

                                elif response.event == Type.UsageResponse:
                                    logger.info(f"[豆包AST] 使用量响应")
                                    continue

                                else:
                                    # 转发中间结果给客户端
                                    logger.info(f"[豆包AST] 收到事件: {response.event}")

                                    # 提取文本
                                    source_text = ""
                                    target_text = ""

                                    try:
                                        if hasattr(response, 'source_subtitle') and response.source_subtitle.text:
                                            source_text = response.source_subtitle.text
                                        if hasattr(response, 'target_subtitle') and response.target_subtitle.text:
                                            target_text = response.target_subtitle.text
                                    except:
                                        pass

                                    # 实时转发给客户端
                                    await websocket.send_json({
                                        "type": "translation",
                                        "event": "intermediate_result",
                                        "source_text": source_text,
                                        "target_text": target_text,
                                        "timestamp": response.response_meta.timestamp if hasattr(response.response_meta, 'timestamp') else None
                                    })

                                    logger.info(f"[豆包AST] 实时翻译: {source_text} -> {target_text}")

                        except websockets.exceptions.ConnectionClosed:
                            logger.info(f"[豆包AST] 连接已关闭")
                        except Exception as e:
                            logger.error(f"[豆包AST] 接收响应异常: {e}", exc_info=True)

                    # 启动接收任务
                    receiver_task = asyncio.create_task(receive_responses())

                    # 实时转发音频到豆包
                    chunk_count = 0
                    while True:
                        # 从队列获取音频块
                        audio_chunk = await audio_queue.get()

                        # None表示结束信号
                        if audio_chunk is None:
                            logger.info(f"[豆包AST] 收到结束信号，发送FinishSession")
                            break

                        chunk_count += 1

                        # 发送音频块到豆包
                        task_request = TranslateRequest()
                        task_request.event = Type.TaskRequest
                        task_request.source_audio.binary_data = audio_chunk

                        task_data = task_request.SerializeToString()
                        await ws.send(task_data)

                        logger.debug(f"[豆包AST] 发送音频块 #{chunk_count}: {len(audio_chunk)} bytes")

                        # 每10个块通知客户端
                        if chunk_count % 10 == 0:
                            await websocket.send_json({
                                "type": "progress",
                                "chunks_sent": chunk_count
                            })

                    # 发送FinishSession
                    finish_request = TranslateRequest()
                    finish_request.event = Type.FinishSession
                    finish_data = finish_request.SerializeToString()
                    await ws.send(finish_data)

                    logger.info(f"[豆包AST] 已发送FinishSession")

                    # 等待接收任务完成
                    await receiver_task

                    logger.info(f"[豆包AST] 翻译会话结束")

            except Exception as e:
                logger.error(f"[豆包AST] 异常: {e}", exc_info=True)
                await websocket.send_json({
                    "type": "error",
                    "message": f"豆包AST连接失败: {str(e)}"
                })

        # 并发运行两个任务
        client_task = asyncio.create_task(handle_client_messages())
        doubao_task = asyncio.create_task(forward_to_doubao())

        # 等待任务完成
        await asyncio.gather(client_task, doubao_task, return_exceptions=True)

        # 更新记录状态
        if record:
            record.status = "completed"
            await record.save()

        logger.info(f"[实时流式翻译] 会话结束: {session_id}")

    except WebSocketDisconnect:
        logger.info(f"[实时流式翻译] 客户端断开连接: {session_id}")
        if record and record.status == "processing":
            record.status = "failed"
            await record.save()

    except Exception as e:
        logger.error(f"[实时流式翻译] 处理异常: {e}", exc_info=True)
        try:
            await websocket.send_json({
                "type": "error",
                "message": f"服务器错误: {str(e)}"
            })
        except:
            pass

        if record:
            try:
                record.status = "failed"
                await record.save()
            except:
                pass

    finally:
        logger.info(f"[实时流式翻译] 清理资源: {session_id}")
        if doubao_ws:
            try:
                await doubao_ws.close()
            except:
                pass


__all__ = ["voice_websocket_streaming_router"]
