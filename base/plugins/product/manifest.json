                },
                {
                    "name": "产品详情",
                    "path": "/products/detail",
                    "icon": "Detail",
                    "component": "product/ProductDetail",
                    "sort": 2,
                    "is_hidden": true,
                    "menu_type": "menu",
                    "permission_code": "product:detail"
                }
            ]
        }
